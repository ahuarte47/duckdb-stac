# name: test/sql/stac_api_extensions.test
# description: test stac extension
# group: [sql]

require stac

query II
SELECT
    id, "eo:cloud_cover"
FROM
    STAC_Search(
        'https://stac.dataspace.copernicus.eu/v1/search',
        collections := ['sentinel-2-l2a'],
        filter := '{
          "op": "and",
          "args": [
            {
              "op": ">=",
              "args": [ { "property": "datetime" }, { "timestamp": "2021-09-30T00:00:00Z" } ]
            },
            {
              "op": "<=",
              "args": [ { "property": "datetime" }, { "timestamp": "2021-10-01T00:00:00Z" } ]
            },
            {
              "op": "s_intersects",
              "args": [
                {
                  "property": "geometry"
                },
                {
                  "type": "Polygon",
                  "coordinates": [
                    [
                      [-1.695007724869786,42.788757186108654],
                      [-1.604482013650674,42.788757186108654],
                      [-1.604482013650674,42.842441501962270],
                      [-1.695007724869786,42.842441501962270],
                      [-1.695007724869786,42.788757186108654]
                    ]
                  ]
                }
              ]
            }
          ]
        }'
    )
ORDER BY
    id
;
----
S2B_MSIL2A_20210930T105749_N0500_R094_T30TWN_20230119T154537	22.61
S2B_MSIL2A_20210930T105749_N0500_R094_T30TXN_20230119T154537	13.33

query II
SELECT
    id, "eo:cloud_cover"
FROM
    STAC_Search(
        'https://stac.dataspace.copernicus.eu/v1/search',
