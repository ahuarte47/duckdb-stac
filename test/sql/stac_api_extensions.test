            },
            {
              "op": "<=",
              "args": [ { "property": "datetime" }, { "timestamp": "2021-10-01T00:00:00Z" } ]
            },
            {
              "op": "<=",
              "args": [ { "property": "eo:cloud_cover" }, 15.0 ]
            },
